# --- MySQL (сервер тал) -------------------------------------------------------
# Hostinger дээр hPanel → Databases хэсгээс сан, хэрэглэгчийг үүсгээд утгыг
# энд буулгана. Апптай нэг сервер дээр байвал host нь localhost.
DATABASE_URL=mysql://user:password@localhost:3306/bbuch

# Нөөц нэр — ТОХИРУУЛСАН БОЛ DATABASE_URL-ыг ДАРНА.
# Зарим hosting самбар "DATABASE_URL" нэрийг хадгалахгүй эсвэл хуучин утгыг
# барьж үлддэг. Тийм үед энэ нэрийг ашиглана. Ердийн үед хоосон орхино.
# MYSQL_URL=
# SSL: "require" — жинхэнэ сертификат, "relaxed" — өөрийн гарын үсэгтэй,
# хоосон орхивол SSL хэрэглэхгүй (нэг серверийн дотор)
DATABASE_SSL=
# Нэг instance-ын холболтын дээд тоо (default 5)
DATABASE_POOL_MAX=5

# --- Client (browser-т ил гарна) ---------------------------------------------
# Firebase Console → Project settings → General / Cloud Messaging
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bbuch-edba7
# Firebase Console → Storage → эхний мөрөнд харагдах bucket нэр
# (жишээ: bbuch-edba7.firebasestorage.app). Хоосон орхивол projectId-аас үүснэ.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bbuch-edba7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin (ЗӨВХӨН сервер тал — хэзээ ч git-д commit хийхгүй) --------
# Хэрэглэгчийн ID token шалгах болон FCM илгээхэд ашиглана.
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=bbuch-edba7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bbuch-edba7.iam.gserviceaccount.com
# private_key-г бүтнээр нь, "\n" тэмдэгтүүдтэй нь хамт хашилтанд хийж бичнэ:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Оношилгоо (сонголтоор) ---------------------------------------------------
# /api/health нь эрхгүй дуудагчид зөвхөн {"status":"ok"} буцаана. Дэлгэрэнгүй
# тохиргооны задаргаа (сангийн хост, түлхүүрийн төлөв, драйверийн алдаа) нь
# халдагчид зориулсан зураглал болдог тул нууцаар хамгаалагдсан:
#
#   curl -H "x-health-token: <утга>" https://.../api/health
#
# Нэвтэрсэн супер админ ч мөн дэлгэрэнгүйг харна. Гэхдээ өгөгдлийн сан унасан
# үед супер админыг таних боломжгүй болдог — яг тэр үед энэ түлхүүр хэрэгтэй
# тул байршуулалт дээр заавал тохируулахыг зөвлөнө. Урт санамсаргүй утга:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_TOKEN=

# --- Content-Security-Policy (шатлан гаргах) ----------------------------------
# off | report-only | enforce   (хоосон = off)
#
# CSP нь тарьсан скрипт өгөгдлийг гадагш гаргахыг таслах хамгийн хүчтэй давхарга
# боловч буруу тохируулбал хуудсыг чимээгүйхэн эвдэнэ. Тиймээс шатлан гаргана:
#
#   1. CSP_MODE=report-only  → апп дахин асаа → нэвтэрч ороод БҮХ хуудсыг
#      тойрно (ялангуяа газрын зураг, тайлан, зураг байршуулах). DevTools →
#      Console дээр "[Report Only] Refused to …" мөр байгаа эсэхийг шалгана.
#   2. Зөрчил гарвал next.config.ts доторх `csp` жагсаалтад хостыг нэмнэ.
#   3. Хоёр дахь тойрог цэвэр бол CSP_MODE=enforce.
#
# ⚠ Утга солих бүрд аппыг дахин асаана — headers() нь серверийн эхлэлд нэг л
# удаа уншигдана:  touch hbuilds/current/nodejs/tmp/restart.txt
CSP_MODE=
