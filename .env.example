# --- MySQL (сервер тал) -------------------------------------------------------
# Hostinger дээр hPanel → Databases хэсгээс сан, хэрэглэгчийг үүсгээд утгыг
# энд буулгана. Апптай нэг сервер дээр байвал host нь localhost.
DATABASE_URL=mysql://user:password@localhost:3306/bbuch

# Нөөц нэр — ТОХИРУУЛСАН БОЛ DATABASE_URL-ыг ДАРНА.
# Зарим hosting самбар "DATABASE_URL" нэрийг хадгалахгүй эсвэл хуучин утгыг
# барьж үлддэг. Тийм үед энэ нэрийг ашиглана. Ердийн үед хоосон орхино.
# MYSQL_URL=
# SSL: "require" — жинхэнэ сертификат, "relaxed" — өөрийн гарын үсэгтэй,
# хоосон орхивол SSL хэрэглэхгүй (нэг серверийн дотор)
DATABASE_SSL=
# Нэг instance-ын холболтын дээд тоо (default 5)
#
# ⚠ ЭНЭ ТОО ПРОЦЕССЫН ТООГООР ҮРЖИНЭ. Passenger нь ачаалал ихсэхэд аппын
# хэд хэдэн процесс зэрэг ажиллуулдаг тул бодит холболт = POOL_MAX × процесс.
# Hostinger дээр MySQL хэрэглэгчийн холболтын хязгаар ихэвчлэн 25-75 байдаг —
# хэтэрвэл `ER_CON_COUNT_ERROR` гарч, апп бүхэлдээ 503 өгч эхэлнэ.
# Анхдагчийг 3 болгосон: Hostinger дээр процессын тоог бид хянадаггүй тул
# аюулгүй тал руугаа. Хариу удаашрах шинж (хүсэлт дараалалд хүлээх) илэрвэл
# нэмж болно, харин "Too many connections" гарвал бууруулна.
DATABASE_POOL_MAX=3

# Бүх холболт завгүй үед хэдэн хүсэлт дараалалд хүлээхийг зөвшөөрөх вэ.
#
# Хязгааргүй (0) байвал сан удаашрахад хүсэлт хуримтлагдсаар Passenger таймаут
# → 502 өгнө. Хэт бага байвал эсрэгээрээ: ачааллын хэмжилтээр 12 нь 20 зэрэг
# хэрэглэгчид throughput-ыг 3000-аас 5 хүс/сек болтол унагаж байсан.
#
# 100 нь хэмжилтээр батлагдсан тэнцвэр: асуулга 1-2ms байдаг тул дараалал
# ~70ms дотор цэвэрлэгдэнэ, харин сан үнэхээр зогсвол 103 хүсэлтээс цааш нь
# шууд 503 өгч таслана.
DATABASE_QUEUE_LIMIT=100

# --- Client (browser-т ил гарна) ---------------------------------------------
# Firebase Console → Project settings → General / Cloud Messaging
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bbuch-edba7
# Firebase Console → Storage → эхний мөрөнд харагдах bucket нэр
# (жишээ: bbuch-edba7.firebasestorage.app). Хоосон орхивол projectId-аас үүснэ.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bbuch-edba7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin (ЗӨВХӨН сервер тал — хэзээ ч git-д commit хийхгүй) --------
# Хэрэглэгчийн ID token шалгах болон FCM илгээхэд ашиглана.
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=bbuch-edba7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bbuch-edba7.iam.gserviceaccount.com
# private_key-г бүтнээр нь, "\n" тэмдэгтүүдтэй нь хамт хашилтанд хийж бичнэ:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Backup ------------------------------------------------------------------
# Хуулбар нь Google Drive дээр хадгалагдана.
#
# ⚠ Drive-ийн холболтыг ЭНД тохируулахгүй. Супер админаар нэвтэрч
# /backup хуудасны «Google Drive» хэсгээс холбоно — Client ID/secret,
# зөвшөөрөл, фолдер бүгд тэндээс бүрдэж, өгөгдлийн санд хадгалагдана.
# (Refresh token нь OAuth урсгалын дунд үүсдэг тул орчны хувьсагчид
# байрлуулах боломжгүй.)
#
# Cron-ын токеныг ч ЭНД тохируулах шаардлагагүй: /backup хуудасны «Токен
# үүсгэх» товч түүнийг үүсгээд, hPanel-д хуулж тавих бүтэн командыг харуулна.
# Токен нь өгөгдлийн санд хадгалагдана.
#
# Доорх хувьсагч нь ЗӨВХӨН нөөц зам (баазад токен байхгүй үед ажиллана).
# Ердийн үед хоосон орхино.
BACKUP_TOKEN=
# Хадгалах хугацааг ч /backup хуудаснаас өөрчилнө (анхдагч 15 хоног).
# Доорх хувьсагч нь зөвхөн нөөц зам — баазад утга байхгүй үед ажиллана.
#
# Хугацаа хэтэрсэн ч хамгийн сүүлийн 3 хуулбарыг ХЭЗЭЭ Ч устгахгүй: нөөцлөлт
# хэсэг хугацаанд ажиллаагүй байхад бүгд алга болохоос сэргийлнэ.
BACKUP_RETENTION_DAYS=

# --- Оношилгоо (сонголтоор) ---------------------------------------------------
# /api/health нь эрхгүй дуудагчид зөвхөн {"status":"ok"} буцаана. Дэлгэрэнгүй
# тохиргооны задаргаа (сангийн хост, түлхүүрийн төлөв, драйверийн алдаа) нь
# халдагчид зориулсан зураглал болдог тул нууцаар хамгаалагдсан:
#
#   curl -H "x-health-token: <утга>" https://.../api/health
#
# Нэвтэрсэн супер админ ч мөн дэлгэрэнгүйг харна. Гэхдээ өгөгдлийн сан унасан
# үед супер админыг таних боломжгүй болдог — яг тэр үед энэ түлхүүр хэрэгтэй
# тул байршуулалт дээр заавал тохируулахыг зөвлөнө. Урт санамсаргүй утга:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_TOKEN=

# --- Content-Security-Policy (шатлан гаргах) ----------------------------------
# off | report-only | enforce   (хоосон = ENFORCE)
#
# CSP нь тарьсан скрипт өгөгдлийг гадагш гаргахыг таслах хамгийн хүчтэй давхарга
# боловч буруу тохируулбал хуудсыг чимээгүйхэн эвдэнэ. Тиймээс шатлан гаргана:
#
#   1. report-only → нэвтэрч ороод БҮХ хуудсыг
#      тойрно (ялангуяа газрын зураг, тайлан, зураг байршуулах). DevTools →
#      Console дээр "[Report Only] Refused to …" мөр байгаа эсэхийг шалгана.
#      Энэ горим ЮУ Ч ХААДАГГҮЙ тул апп хэвийн ажиллана.
#   2. Зөрчил гарвал next.config.ts доторх `csp` жагсаалтад хостыг нэмнэ.
#   3. Тойрог цэвэр бол CSP_MODE=enforce.
#
# Ямар нэг шалтгаанаар толгойг бүрмөсөн авах шаардлагатай бол CSP_MODE=off.
#
# ⚠ АНХДАГЧ нь `enforce` болсон. Урьд нь `report-only` байсан нь практикт
# "хамгаалалт үүрд унтраалттай" гэсэн үг байв. Ямар нэг зүйл эвдэрвэл
# CSP_MODE=report-only гэж env-ээр шууд буцаана — код засах шаардлагагүй.
#
# ⚠ Утга солисны дараа ЗААВАЛ ДАХИН DEPLOY хийнэ (hPanel → Redeploy, эсвэл
# push). Зөвхөн restart.txt-ээр сэргээхэд хангалтгүй: Next нь headers()-ийг
# BUILD ҮЕД дуудаж, үр дүнг .next/routes-manifest.json-д шигтгэдэг тул
# ажиллах үеийн процесс тэр бэлэн жагсаалтыг л уншина.
CSP_MODE=
