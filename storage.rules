rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ------------------------------------------------------------------
    // Эрхийн шалгалт — Firebase ID token доторх custom claims-аар
    //
    // Storage дүрэм нь MySQL рүү хандаж чаддаггүй. Тиймээс сервер нь эрх/төлөв
    // өөрчлөгдөх бүрд түүнийг хэрэглэгчийн токен руу хуулдаг
    // (src/lib/api/claims.ts). Эдгээр талбарыг хэрэглэгч зохиож чадахгүй —
    // токеныг Firebase өөрөө гарын үсэглэдэг.
    //
    // ⚠ Claim нь токен дотор ХӨЛДДӨГ: эрх нь хасагдсан хүний токен дуусах
    // хүртлээ (ихдээ 1 цаг) хуучин утгаа барина. Тиймээс эдгээр дүрэм нь
    // /api/* дээрх MySQL-ийн шалгалтыг ОРЛОХГҮЙ — тэр нь шууд хүчинтэй болдог.
    // Энд байгаа нь "нэвтэрсэн бол хангалттай" гэсэн хуучин байдлаас хамаагүй
    // хатуу боловч цорын ганц давхарга биш.
    // ------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function claim(name) {
      return request.auth.token.get(name, '');
    }

    /**
     * Идэвхтэй админ мөн эсэх.
     *
     * `status == 'active'` шалгалт чухал: хаагдсан админ эрхээ хадгалж
     * үлдэхгүй. Claim байхгүй хуучин токенд `get()` нь '' буцаах тул шалгалт
     * унана — энэ нь ЗӨВ тал руугаа унаж байгаа хэрэг (хаана).
     */
    function activeAdmin() {
      return signedIn()
             && (claim('role') == 'admin' || claim('role') == 'super')
             && claim('status') == 'active';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ------------------------------------------------------------------
    // Профайлын зураг: зөвхөн эзэн нь бичнэ, нэвтэрсэн хүн уншина.
    //
    // Энд claim шаардахгүй — зам дотор uid байгаа тул эзэмшлийг Firebase
    // өөрөө баталгаажуулж чадна. Шинэ бүртгүүлсэн (pending) хүн ч профайлын
    // зургаа тавьж чадах ёстой.
    // ------------------------------------------------------------------
    match /profile_photos/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && isImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // Эд хөрөнгийн зураг — ЗӨВХӨН идэвхтэй админ.
    //
    // Өмнө нь `if request.auth != null` байсан: нэвтэрсэн ямар ч хүн —
    // баталгаажаагүй (pending), хаагдсан (blocked) ч — дурын эд хөрөнгийн
    // зургийг УСТГАЖ, дурын хавтас руу файл байршуулж чаддаг байв. Зургийг
    // бүртгэлд холбох /api/assets/[id]/images route нь аль хэдийн зөвхөн
    // админд нээлттэй байсан тул энэ дүрэм түүнтэй одоо тохирлоо.
    // ------------------------------------------------------------------
    match /assets/{assetId}/{fileName} {
      allow read: if signedIn();
      allow write: if activeAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && isImage();
      allow delete: if activeAdmin();
    }

    // Бусад бүх зам хаалттай.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
